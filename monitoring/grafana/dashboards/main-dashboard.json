{
  "__inputs": [],
  "__requires": [],
  "title": "Video QA Tester",
  "uid": "videoqa-main",
  "version": 1,
  "schemaVersion": 38,
  "tags": ["videoqa", "testing"],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "title": "Test Status Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(videoqa_tests_total{status=\"passed\"})",
          "legendFormat": "Passed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }]
          }
        }
      }
    },
    {
      "title": "Failed Tests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "targets": [
        {
          "expr": "sum(videoqa_tests_total{status=\"failed\"})",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(videoqa_errors_total[5m]) / rate(videoqa_tests_total[5m]) * 100",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "targets": [
        { "expr": "videoqa_users_concurrent" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Test Duration (P99)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(videoqa_test_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "value": 60, "color": "yellow" },
              { "value": 120, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Workers Active",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "targets": [
        { "expr": "videoqa_workers_active" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Queue Depth",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "targets": [
        { "expr": "videoqa_queue_depth" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Test Duration Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(videoqa_test_duration_seconds_bucket[5m])",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Tests per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(videoqa_tests_total[1m])",
          "legendFormat": "Tests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "title": "Errors by Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(videoqa_errors_total) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "title": "Pass/Fail Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "rate(videoqa_tests_total{status=\"passed\"}[5m])",
          "legendFormat": "Passed"
        },
        {
          "expr": "rate(videoqa_tests_total{status=\"failed\"}[5m])",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "title": "Watch Time Accumulated",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum(videoqa_watch_time_seconds)",
          "legendFormat": "Total Watch Time (s)"
        }
      ]
    },
    {
      "title": "Scenario Performance",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "videoqa_scenario_info",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": {}, "renameByName": { "Value": "# runs" } } }
      ]
    },
    {
      "title": "Recent Alerts",
      "type": "alertlist",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "options": {
        "showOptions": ["alerts"],
        "maxItems": 20,
        "sortOrder": 1,
        "alertName": "",
        "dashboardAlerts": false,
        "stateFilter": ["alerting", "firing"]
      }
    }
  ],
  "rows": [],
  "graphTooltip": 0,
  "links": []
}
