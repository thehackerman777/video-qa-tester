# ============================================================
# Video QA Tester — Environment Variables
# ============================================================

# === Orchestrator ===
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_API_KEY=change-this-to-a-secure-key

# === Redis ===
REDIS_URL=redis://redis:6379

# === PostgreSQL (for test result storage) ===
DATABASE_URL=postgresql://videoqa:videoqa@postgres:5432/videoqa

# === YouTube API (optional, for channel scanning) ===
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# === Default Test Settings ===
LOG_LEVEL=info
DEFAULT_CONCURRENCY=10
DEFAULT_HEADLESS=true
MAX_BROWSERS=20

# === Email (for test account notifications) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === Grafana (for monitoring) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
